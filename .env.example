# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.

# --- Email delivery (used for OTP login emails and scheduled report emails) ---
# If RESEND_API_KEY is set, it's used INSTEAD of SMTP below. Prefer this on
# hosts that block outbound SMTP (Render's web services do — smtplib fails
# there with "[Errno 101] Network is unreachable" regardless of credentials).
# Get a key at https://resend.com — free tier works, no domain verification
# needed if you leave RESEND_FROM_EMAIL unset (uses their onboarding@resend.dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- SMTP fallback (used only when RESEND_API_KEY is unset — fine for local dev) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
# For Gmail, generate an App Password (not your account password): https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_USE_TLS=1
