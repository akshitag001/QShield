# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.

# --- Email delivery (used for OTP login emails and scheduled report emails) ---
# Priority order: SENDGRID_API_KEY > RESEND_API_KEY > SMTP below. The HTTP-API
# providers (SendGrid/Resend) are preferred on hosts that block outbound SMTP
# (Render's web services do — smtplib fails there with "[Errno 101] Network is
# unreachable" regardless of credentials); a plain HTTPS call isn't affected.
#
# SendGrid: sign up at https://sendgrid.com, then Settings > Sender
# Authentication > Single Sender Verification to verify ONE email address you
# already own (click the confirmation link — no domain purchase needed). Once
# verified, you can send FROM that address TO any recipient. Free tier: 100/day.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Resend: sign up at https://resend.com. Free tier works, but the shared
# onboarding@resend.dev sender can ONLY send to your own Resend signup email
# until you verify a domain (Domains > Add Domain) — see resend.com/domains.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- SMTP fallback (used only when RESEND_API_KEY is unset — fine for local dev) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
# For Gmail, generate an App Password (not your account password): https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_USE_TLS=1
